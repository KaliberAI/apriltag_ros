<launch>
  <arg name="launch_prefix" default="" />
  <arg name="camera_name" default="/camera/color" />
  <arg name="image_topic" default="image_rect_raw" />
  <arg name="target_offset" default="0.9" />
  <arg name="source_frame_name" default="tag_7" />
  <arg name="target_frame_name" default="track_target" />
  <arg name="enable_detection" default="true" />

  <!-- AprilTag detection node, only if enabled -->
  <node
    pkg="apriltag_ros"
    exec="apriltag_ros_continuous_detector_node"
    name="apriltag_ros_continuous_detector_node"
    output="screen"
    launch-prefix="$(var launch_prefix)"
    if="$(var enable_detection)"
  >
    <remap from="~/image_rect" to="$(var camera_name)/$(var image_topic)" />
    <remap from="~/camera_info" to="$(var camera_name)/camera_info" />

    <param from="$(find-pkg-share apriltag_ros)/config/settings.param.yaml" />
    <param from="$(find-pkg-share apriltag_ros)/config/tags.param.yaml" />
    <param name="publish_tag_detections_image" value="true" />
  </node>

  <!-- static transform always launches -->
  <node
    pkg="tf2_ros"
    exec="static_transform_publisher"
    name="tag_7_to_track_frame_tf"
    args="0 0 $(var target_offset) 0 1.5708 0 $(var source_frame_name) $(var target_frame_name)"
  />
</launch>

